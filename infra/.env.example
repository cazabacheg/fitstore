# FitStore: variables de entorno del entorno de desarrollo (infraestructura 10.5).
#
# Uso:   cp infra/.env.example infra/.env
#        docker compose -f infra/docker-compose.yml -f infra/docker-compose.dev.yml up -d
#
# Los valores de este archivo son SOLO DE DESARROLLO LOCAL: sirven para que la plataforma arranque, no protegen
# nada. Nunca los uses en la nube; allí cada valor se cambia por uno propio en el .env de la VM. El archivo .env
# real está en .gitignore y no se sube nunca. Las pasarelas de pago y el SMTP reales se dejan vacíos.

# --- Base de datos: un usuario y una contraseña por servicio (ADR-006) ---
POSTGRES_PASSWORD=dev-postgres-clave
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=dev-auth-clave
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=dev-catalog-clave
SETTINGS_DB_USER=settings_user
SETTINGS_DB_PASSWORD=dev-settings-clave
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=dev-order-clave
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=dev-payment-clave
DELIVERY_DB_USER=delivery_user
DELIVERY_DB_PASSWORD=dev-delivery-clave
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=dev-notification-clave

# --- RabbitMQ ---
RABBITMQ_USER=fitstore
RABBITMQ_PASSWORD=dev-rabbit-clave

# --- Redis ---
REDIS_HOST=redis

# --- Almacenamiento S3 / Garage (ADR-013). La clave de acceso la importa garage-init en el primer arranque ---
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=GKdeadbeefdeadbeefdeadbeef
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET_PUBLICO=fitstore-media
S3_BUCKET_PRIVADO=fitstore-privado
GARAGE_RPC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
GARAGE_ADMIN_TOKEN=dev-garage-admin-token

# --- JWT ---
# Mientras auth no firma (spec 1) el compose de dev monta infra/dev/jwks-prueba.json para que los servicios y el
# gateway validen con él (SPEC-0a I2); por eso no se define aquí: el JWKS de prueba no debe llegar a la nube.
# Rutas de las claves PEM de auth-service (spec 1); en dev, auth genera un par al arrancar si no existen
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# --- Administrador inicial (lo crea auth-service, spec 1) ---
ADMIN_EMAIL=admin@fitstore.local
ADMIN_PASSWORD=dev-admin-clave

# --- Pasarelas de pago (spec 5). En dev se usa la pasarela simulada ---
# En dev el perfil activa la pasarela simulada; esta variable solo decide si la nube (demo) la muestra.
PAGOS_SIMULADO_HABILITADO=false
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Mercado Pago: clave pública (la usa el formulario del navegador), token de acceso y secreto de los webhooks.
MP_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Correo (spec 7). En dev, Mailpit recibe todo ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# true con Amazon SES (puerto 587, cifrado); false con Mailpit.
SMTP_STARTTLS=false
# Remitente de los correos; en la nube debe ser una dirección verificada en SES.
MAIL_FROM="FitStore <no-responder@fitstore.local>"

# --- URLs públicas ---
FITSTORE_PUBLIC_URL=http://localhost:8080
STOREFRONT_URL=http://localhost:4200
BACKOFFICE_URL=http://localhost:4300
# Los navegadores resuelven *.localhost a 127.0.0.1: el bucket público se sirve por el endpoint web de Garage
MEDIA_BASE_URL=http://fitstore-media.web.localhost:3902

# --- Dominio DuckDNS (solo la nube, spec 8) ---
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- Config-server y Swagger ---
CONFIG_USER=config
CONFIG_PASSWORD=dev-config-clave
SWAGGER_USER=swagger
SWAGGER_PASSWORD=dev-swagger-clave
