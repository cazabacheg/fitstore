      "name": "CA-5-21 Webhook de Mercado Pago con firma inválida responde 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CA-5-21 401 FIRMA_INVALIDA', function () { pm.response.to.have.status(401); pm.expect(pm.response.json().codigo).to.eql('FIRMA_INVALIDA'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-signature",
            "value": "ts=1700000000,v1=firma-falsa"
          },
          {
            "key": "x-request-id",
            "value": "postman-1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pagos/webhooks/mercadopago",
