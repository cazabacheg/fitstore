          ],
          "path": [
            "api",
            "v1",
            "pagos",
            "{{codigoPedidoAprobado}}",
            "boleta"
          ]
        },
        "description": "La boleta se genera en segundo plano; si responde 404 espera unos segundos y repite."
      }
