    {
      "name": "CA-5-20 Webhook simulado de Mercado Pago con firma válida",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Firma de Mercado Pago: HMAC-SHA256 de 'id:<data.id>;request-id:<x-request-id>;ts:<ts>;' con el secreto de webhooks (variable mpWebhookSecret).",
              "const ts = String(Math.floor(Date.now() / 1000)); const reqId = 'postman-' + ts; const idPago = pm.collectionVariables.get('idPagoMp') || '123456789';",
              "const v1 = CryptoJS.HmacSHA256('id:' + idPago + ';request-id:' + reqId + ';ts:' + ts + ';', pm.collectionVariables.get('mpWebhookSecret')).toString();",
              "pm.collectionVariables.set('requestIdMp', reqId); pm.collectionVariables.set('firmaMp', 'ts=' + ts + ',v1=' + v1); pm.collectionVariables.set('notificacionMp', String(Date.now())); pm.collectionVariables.set('idPagoMp', idPago);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// El aviso firmado solo se acepta si la plataforma tiene el mismo MP_WEBHOOK_SECRET que la variable mpWebhookSecret (sandbox de Mercado Pago); sin secreto el paso se omite, como los de Mailpit en notification",
              "if (pm.collectionVariables.get('mpWebhookSecret')) { pm.test('CA-5-20 200 recibido', function () { pm.response.to.have.status(200); }); } else { pm.test('CA-5-20 omitido: define mpWebhookSecret (el mismo MP_WEBHOOK_SECRET de la plataforma) para firmar el aviso', function () { pm.expect(pm.collectionVariables.get('mpWebhookSecret')).to.eql(''); }); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-signature",
            "value": "{{firmaMp}}"
          },
          {
            "key": "x-request-id",
            "value": "{{requestIdMp}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pagos/webhooks/mercadopago",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
