        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 12345,\n  \"type\": \"payment\",\n  \"action\": \"payment.updated\",\n  \"data\": {\n    \"id\": \"123456789\"\n  }\n}"
        }
      }
    },
    {
      "name": "CA-5-20 Webhook simulado de Mercado Pago con firma válida",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Firma de Mercado Pago: HMAC-SHA256 de 'id:<data.id>;request-id:<x-request-id>;ts:<ts>;' con el secreto de webhooks (variable mpWebhookSecret).",
              "const ts = String(Math.floor(Date.now() / 1000)); const reqId = 'postman-' + ts; const idPago = pm.collectionVariables.get('idPagoMp') || '123456789';",
              "const v1 = CryptoJS.HmacSHA256('id:' + idPago + ';request-id:' + reqId + ';ts:' + ts + ';', pm.collectionVariables.get('mpWebhookSecret')).toString();",
              "pm.collectionVariables.set('requestIdMp', reqId); pm.collectionVariables.set('firmaMp', 'ts=' + ts + ',v1=' + v1); pm.collectionVariables.set('notificacionMp', String(Date.now())); pm.collectionVariables.set('idPagoMp', idPago);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CA-5-20 200 recibido', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-signature",
            "value": "{{firmaMp}}"
          },
          {
            "key": "x-request-id",
            "value": "{{requestIdMp}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pagos/webhooks/mercadopago",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "pagos",
            "webhooks",
            "mercadopago"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"id\": {{notificacionMp}}, \"type\": \"payment\", \"action\": \"payment.updated\", \"data\": {\"id\": \"{{idPagoMp}}\"}}"
        },
        "description": "Solo confirma un pago si existe una transacción con ese id en Mercado Pago (sandbox)."
      }
    },
    {
      "name": "CA-5-19 Más de 10 intentos de cobro en un minuto responden 429",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 10 intentos seguidos para agotar el límite del gateway (10 por minuto por usuario)",
              "for (let n = 0; n < 10; n++) { pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/v1/pagos/' + pm.collectionVariables.get('codigoPedidoRechazo') + '/cargos', method: 'POST', header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('tokenCliente'), 'Content-Type': 'application/json', 'Idempotency-Key': 'rate-' + Date.now() + '-' + n }, body: { mode: 'raw', raw: '{\"proveedor\":\"SIMULADO\",\"medio\":\"TARJETA\",\"token\":\"sim_0002\"}' } }, () => {}); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CA-5-19 429 Demasiados intentos', function () { pm.response.to.have.status(429); });"
            ]
          }
        }
      ],
