    {
      "name": "CA-5-29 Descargar mi boleta (PDF)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// La boleta se genera en segundo plano tras el pago: se consulta hasta 15 veces (2 s entre intentos) antes de la petición que se verifica",
              "const url = pm.variables.replaceIn('{{baseUrl}}/api/v1/pagos/{{codigoPedidoAprobado}}/boleta');",
              "const token = pm.collectionVariables.get('tokenCliente');",
              "function intentar(n) {",
              "  pm.sendRequest({ url: url, method: 'GET', header: { Authorization: 'Bearer ' + token } }, function (err, res) {",
              "    if (!err && res.code === 200) { return; }",
              "    if (n < 15) { setTimeout(function () { intentar(n + 1); }, 2000); }",
              "  });",
              "}",
              "intentar(1);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CA-5-29 200 application/pdf', function () { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); });",
              "pm.test('CA-5-29 el archivo se llama como el número de la boleta', function () { pm.expect(pm.response.headers.get('Content-Disposition')).to.match(/Boleta-B001-\\d{8}\\.pdf/); });"
            ]
          }
        }
      ],
