  "item": [
    {
      "name": "Preparación (ingresos y pedidos)",
      "description": "Deja la colección autónoma: ingresa con las cuentas de demostración y el ADMIN, y crea con la API de order los 3 pedidos pendientes de pago que usan los cobros. Son 4 ingresos, por debajo del límite del gateway (5 por minuto por IP): si corres otra colección antes, espera 1 minuto.",
      "item": [
        {
          "name": "Preparación: ingreso de la clienta (Lucía)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CA-1-04 inicia sesión', function () { pm.response.to.have.status(200); });",
                  "pm.test('CA-1-04 entrega el access token', function () { pm.collectionVariables.set('tokenCliente', pm.response.json().data.accessToken); pm.expect(pm.collectionVariables.get('tokenCliente')).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{demoClienteEmail}}\", \"password\": \"{{demoPassword}}\"}"
            }
          }
        },
