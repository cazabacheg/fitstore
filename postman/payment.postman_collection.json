            "exec": [
              "pm.test('CA-5-03 200 con el monto y los medios disponibles', function () { pm.response.to.have.status(200); const d = pm.response.json().data; pm.expect(d.codigoPedido).to.eql(pm.collectionVariables.get('codigoPedidoAprobado')); pm.expect(d.medios.length).to.be.above(0); });",
