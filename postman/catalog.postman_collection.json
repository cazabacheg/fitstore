              "raw": "{\"codigo\": \"{{letras}}\", \"nombre\": \"Legging Postman {{sufijo}}\", \"descripcion\": \"Producto de prueba de Postman\", \"precioBase\": 59.9, \"categoriaIds\": [{{catHijaId}}]}",
