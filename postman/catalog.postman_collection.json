{
  "info": {
    "name": "FitStore - catalog (SPEC-2)",
    "description": "Flujo admin (categorías, producto, matriz, imágenes, entrada de stock, publicar) y flujo de tienda (listar, filtrar, detalle, cotizar) a través del gateway, más CA-2-54 (/internal responde 404). Necesita la plataforma levantada con el ADMIN inicial (variables adminEmail y adminPassword) y corre desde la raíz del repositorio (las fotos se toman de backend/catalog-service/src/main/resources/demo/imagenes).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "adminEmail",
      "value": "admin@fitstore.local"
    },
    {
      "key": "adminPassword",
      "value": "dev-admin-clave"
    }
  ],
  "item": [
    {
      "name": "Flujo admin",
      "description": "",
      "item": [
        {
          "name": "Admin 0 · Iniciar sesión como staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/staff/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "staff",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('sufijo')) {",
                  "  const n = Date.now().toString();",
                  "  pm.collectionVariables.set('sufijo', n.slice(-6));",
                  "  pm.collectionVariables.set('letras', 'PM' + n.slice(-6));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CA-2-17 el ADMIN inicia sesión para administrar el catálogo', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin 1 · Crear categoría raíz",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "categorias"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"Postman {{sufijo}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CA-2-17 crea la categoría raíz', function () { pm.response.to.have.status(201); });",
                  "pm.test('CA-2-17 trae slug único', function () { pm.expect(pm.response.json().data.slug).to.include('postman'); });",
                  "pm.collectionVariables.set('catRaizId', pm.response.json().data.id);",
                  "pm.collectionVariables.set('catRaizSlug', pm.response.json().data.slug);"
                ]
              }
            }
          ]
        },
