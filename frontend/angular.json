{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "storefront": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/storefront",
      "sourceRoot": "projects/storefront/src",
      "prefix": "fs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/storefront/src/main.ts",
            "tsConfig": "projects/storefront/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/storefront/public"
              }
            ],
            "styles": ["projects/storefront/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "storefront:build:production"
            },
            "development": {
              "buildTarget": "storefront:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200,
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageThresholds": {
              "lines": 80
            },
            "coverageInclude": ["projects/storefront/src/**/*.ts"],
            "coverageExclude": [
              "projects/storefront/src/main.ts",
              "projects/storefront/src/**/*.spec.ts"
            ],
            "coverageReporters": ["text-summary", "html", "lcov"]
          }
        }
      },
      "i18n": {
        "sourceLocale": "es-PE"
      }
    },
    "backoffice": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/backoffice",
      "sourceRoot": "projects/backoffice/src",
      "prefix": "fs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/backoffice/src/main.ts",
            "tsConfig": "projects/backoffice/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/backoffice/public"
              }
            ],
            "styles": ["projects/backoffice/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "backoffice:build:production"
            },
            "development": {
              "buildTarget": "backoffice:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4300,
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageThresholds": {
              "lines": 80
            },
            "coverageInclude": ["projects/backoffice/src/**/*.ts"],
            "coverageExclude": [
              "projects/backoffice/src/main.ts",
              "projects/backoffice/src/**/*.spec.ts"
            ],
            "coverageReporters": ["text-summary", "html", "lcov"]
          }
        }
      },
      "i18n": {
        "sourceLocale": "es-PE"
      }
    },
    "shared": {
      "projectType": "library",
      "root": "projects/shared",
      "sourceRoot": "projects/shared/src",
      "prefix": "fs",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shared/tsconfig.spec.json",
            "coverageThresholds": {
              "lines": 80
            },
            "coverageInclude": ["projects/shared/src/**/*.ts"],
            "coverageExclude": [
              "projects/shared/src/lib/api/**",
              "projects/shared/src/lib/testing/**",
              "projects/shared/src/**/*.spec.ts",
              "projects/shared/src/public-api.ts"
            ],
            "coverageReporters": ["text-summary", "html", "lcov"]
          }
        }
      }
    }
  }
}
