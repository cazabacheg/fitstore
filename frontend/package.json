{
  "name": "fitstore-frontend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "start:storefront": "ng serve storefront --port 4200",
    "start:backoffice": "ng serve backoffice --port 4300",
    "build": "ng build shared && ng build storefront && ng build backoffice",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test",
    "api:generate": "bash scripts/api-generate.sh"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/angular": "19.5.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "ng-packagr": "22.2.4",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
